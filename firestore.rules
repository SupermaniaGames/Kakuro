rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                     && resource.data.uid == request.auth.uid
                     && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                     && resource.data.uid == request.auth.uid;
    }

    // Supermania Ludo
    match /ludoRooms/{code} {
      allow read, write: if request.auth != null;
      match /chat/{msg} {
        allow read, write: if request.auth != null;
      }
    }

    // Supermania Connect Four
    match /connect4Rooms/{code} {
      allow read, write: if request.auth != null;
      match /chat/{msg} {
        allow read, write: if request.auth != null;
      }
    }

    // Supermania Mastermind
    match /mastermindRooms/{code} {
      allow read, write: if request.auth != null;
      match /chat/{msg} {
        allow read, write: if request.auth != null;
      }
      // Secret codes: only the player who made the code can read or write it.
      // The opponent never gets access. Step 3 will use this; it does nothing until then.
      match /secret/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Sooper Ranga: cloud save + total-coins leaderboard
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Sooper Ranga: best score per level (scores/{level}/entries/{uid})
    match /scores/{level}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0;
    }

    // ---- Supermania Kakuro (character is players/{uid}.kkav, covered by the players rule above) ----

    // Per-player summary: levels cleared, best time per level, fastest/average, daily streak.
    // The home screen reads only this one document. Private to the player.
    match /kakuroProgress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // One record per cleared puzzle: kakuroClears/{uid}/items/L12  or  .../items/D20261004-3
    // Fields: kind ('level'|'daily'), level or day+idx, ms, attempts, hints, finished.
    match /kakuroClears/{uid}/items/{pid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                             && request.resource.data.kind in ['level', 'daily']
                             && request.resource.data.ms is int
                             && request.resource.data.ms > 0
                             && request.resource.data.ms < 86400000
                             && request.resource.data.attempts is int
                             && request.resource.data.attempts >= 1
                             && request.resource.data.hints is int
                             && request.resource.data.hints >= 0
                             && request.resource.data.hints <= 9;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Daily leaderboard: one entry per player per day. score = total time of the five puzzles + 30 s per hint.
    // The rule checks the arithmetic; it can not know whether the times themselves are honest.
    match /kakuroDaily/{day}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                             && request.resource.data.ms is int
                             && request.resource.data.ms > 0
                             && request.resource.data.ms < 432000000
                             && request.resource.data.hints is int
                             && request.resource.data.hints >= 0
                             && request.resource.data.hints <= 45
                             && request.resource.data.score is int
                             && request.resource.data.score == request.resource.data.ms + request.resource.data.hints * 30000
                             && request.resource.data.name is string
                             && request.resource.data.name.size() <= 14;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
